<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- The kernel is consumed as a versioned package from nuget.org, never copied: a
         correction made in brandonifco/rules-kernel reaches this engine through a version
         bump. One public source, so no credentials and no source mapping are needed. -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
