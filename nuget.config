<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- The kernel is consumed as a versioned package, never copied: a correction made in
         brandonifco/rules-kernel reaches this engine through a version bump. GitHub
         Packages requires authentication for NuGet even when a package is public, so a
         token is always needed; CI supplies the workflow's own GITHUB_TOKEN and a local
         developer supplies a personal token with read:packages. -->
    <add key="github-brandonifco" value="https://nuget.pkg.github.com/brandonifco/index.json" />
  </packageSources>
  <packageSourceCredentials>
    <github-brandonifco>
      <add key="Username" value="brandonifco" />
      <add key="ClearTextPassword" value="%GITHUB_PACKAGES_TOKEN%" />
    </github-brandonifco>
  </packageSourceCredentials>
</configuration>
