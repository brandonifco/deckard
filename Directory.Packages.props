<Project>

  <!-- Central package management: one place to see and update every external
       dependency. Keeps Dependabot to a single edit point and keeps the three
       test projects from drifting apart. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- The ruleset-agnostic kernel. Referenced, never copied: a correction made in
         rules-kernel reaches this engine through a version bump. -->
    <PackageVersion Include="RulesKernel" Version="0.1.0" />
    <PackageVersion Include="RulesKernel.Randomness" Version="0.1.0" />
    <PackageVersion Include="RulesKernel.Testing" Version="0.1.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

</Project>
